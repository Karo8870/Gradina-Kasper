{
  "name": "ecommerce-test-plain",
  "version": "1.0.0",
  "description": "A blank template to get started with Payload 3.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build --webpack",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev --turbopack",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@c15t/nextjs": "^2.2.1",
    "@delmaredigital/payload-better-auth": "^0.13.0",
    "@hookform/resolvers": "^5.9.1",
    "@icons-pack/react-simple-icons": "^13.15.1",
    "@payloadcms/db-postgres": "3.88.0",
    "@payloadcms/email-nodemailer": "^3.88.0",
    "@payloadcms/next": "3.88.0",
    "@payloadcms/plugin-cloud-storage": "3.88.0",
    "@payloadcms/plugin-seo": "^3.88.0",
    "@payloadcms/richtext-lexical": "3.88.0",
    "@payloadcms/storage-s3": "^3.88.0",
    "@payloadcms/ui": "3.88.0",
    "@tailwindcss/postcss": "^4.3.3",
    "better-auth": "^1.7.5",
    "c15t": "^2.2.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.6",
    "cross-env": "^7.0.3",
    "dotenv": "16.4.7",
    "envalid": "^8.2.0",
    "graphql": "^16.8.1",
    "lucide-react": "^1.43.0",
    "next": "16.3.3",
    "payload": "3.88.0",
    "postcss": "^8.5.28",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.88.0",
    "shadcn": "^4.21.0",
    "sharp": "0.34.2",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.19.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tsx": "4.22.4",
    "typescript": "5.7.3"
  },
  "engines": {
    "node": "^18.20.2 || >=20.9.0",
    "pnpm": "^9 || ^10 || ^11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver"
    ]
  }
}
